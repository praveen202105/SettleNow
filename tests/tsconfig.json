{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@settleflow/shared": ["packages/shared/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["**/*.ts", "**/*.tsx", "../apps/api/src/**/*.d.ts"]
}
